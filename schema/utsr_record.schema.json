{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/utsr-toolmeta/utsr_record.schema.json",
  "title": "UTSR-ToolMeta Record",
  "type": "object",
  "required": [
    "record_id",
    "dataset_meta",
    "source_meta",
    "function_profile",
    "utsr",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string"
    },
    "dataset_meta": {
      "type": "object",
      "required": [
        "dataset_name",
        "schema_version",
        "created_at",
        "language",
        "split",
        "source_record_uid"
      ],
      "additionalProperties": true,
      "properties": {
        "dataset_name": { "type": "string" },
        "schema_version": { "type": "string" },
        "created_at": { "type": "string" },
        "language": { "type": "string" },
        "split": { "type": "string" },
        "source_record_uid": { "type": "string" }
      }
    },
    "source_meta": {
      "type": "object",
      "required": [
        "source_family",
        "source_id"
      ],
      "additionalProperties": true,
      "properties": {
        "source_family": { "type": "string" },
        "source_id": { "type": "string" },
        "source_url": { "type": ["string", "null"] },
        "source_version": { "type": ["string", "null"] },
        "license": { "type": ["string", "null"] },
        "framework": { "type": ["string", "null"] },
        "priority": { "type": ["string", "null"] },
        "collection_method": { "type": ["string", "null"] }
      }
    },
    "function_profile": {
      "type": "object",
      "required": [
        "domain",
        "subdomain",
        "function_type",
        "task_intent",
        "semantic_tags",
        "profile_origin"
      ],
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "string" },
        "subdomain": { "type": "string" },
        "function_type": { "type": "string" },
        "task_intent": { "type": "string" },
        "semantic_tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "profile_origin": { "type": "string" }
      }
    },
    "utsr": {
      "type": "object",
      "required": [
        "source",
        "identity",
        "capability",
        "interface",
        "binding"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "required": [
            "framework",
            "upstream_type",
            "upstream_channel",
            "usage_context",
            "field_origin_map"
          ],
          "additionalProperties": false,
          "properties": {
            "framework": { "type": ["string", "null"] },
            "upstream_type": { "type": ["string", "null"] },
            "upstream_channel": { "type": ["string", "null"] },
            "usage_context": { "type": ["string", "null"] },
            "field_origin_map": { "type": "object" }
          }
        },
        "identity": {
          "type": "object",
          "required": [
            "name",
            "namespace"
          ],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": ["string", "null"] }
          }
        },
        "capability": {
          "type": "object",
          "required": [
            "description",
            "summary",
            "return_description"
          ],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" },
            "summary": { "type": ["string", "null"] },
            "return_description": { "type": ["string", "null"] }
          }
        },
        "interface": {
          "type": "object",
          "required": [
            "input_schema",
            "parameters",
            "output_schema",
            "output_type"
          ],
          "additionalProperties": false,
          "properties": {
            "input_schema": { "type": ["object", "array", "string", "null"] },
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "required",
                  "description",
                  "default",
                  "enum"
                ],
                "additionalProperties": true,
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": ["string", "null"] },
                  "required": { "type": ["boolean", "null"] },
                  "description": { "type": ["string", "null"] },
                  "default": true,
                  "enum": { "type": ["array", "null"] }
                }
              }
            },
            "output_schema": { "type": ["object", "array", "string", "null"] },
            "output_type": { "type": ["string", "null"] }
          }
        },
        "binding": {
          "type": "object",
          "required": [
            "executor_ref",
            "serializer_target",
            "raw_descriptor_ref"
          ],
          "additionalProperties": false,
          "properties": {
            "executor_ref": { "type": ["string", "null"] },
            "serializer_target": { "type": ["string", "null"] },
            "raw_descriptor_ref": { "type": ["string", "null"] }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "raw_dir",
        "raw_descriptor_ref",
        "parser",
        "parser_version",
        "parse_time_utc",
        "candidate"
      ],
      "additionalProperties": true,
      "properties": {
        "raw_dir": { "type": ["string", "null"] },
        "raw_descriptor_ref": { "type": ["string", "null"] },
        "parser": { "type": ["string", "null"] },
        "parser_version": { "type": ["string", "null"] },
        "parse_time_utc": { "type": ["string", "null"] },
        "candidate": { "type": ["object", "null"] }
      }
    }
  }
}

