{
  "$id": "urn:utsr:toolmeta:function-profile:v0.2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Functional profile for the v0.2 public dataset. Exactly ten semantic fields, without per-record annotation metadata. Unknown or null denotes insufficient evidence. Derived labels are not original tool declarations and must not be exposed to evaluated agents.",
  "properties": {
    "action_mode": {
      "enum": [
        "single",
        "multi",
        "unknown"
      ]
    },
    "cardinality": {
      "enum": [
        "single",
        "batch",
        "collection",
        "unknown"
      ]
    },
    "effect_class": {
      "enum": [
        "read_only",
        "compute_only",
        "state_creating",
        "state_modifying",
        "state_deleting",
        "external_side_effect",
        "mixed",
        "unknown"
      ]
    },
    "primary_action": {
      "description": "Single action class, or null for multi-action tools, unknown-action tools, and ambiguous multi-verb names.",
      "enum": [
        "search",
        "list",
        "retrieve",
        "create",
        "update",
        "delete",
        "execute",
        "transform",
        "communicate",
        "transfer",
        "interact",
        null
      ]
    },
    "primary_domain": {
      "description": "Frozen 37-class L1 vocabulary; 'unknown' when evidence is insufficient.",
      "enum": [
        "advertising",
        "analytics",
        "artificial_intelligence_machine_learning",
        "audio",
        "blockchain",
        "business",
        "cloud",
        "commerce",
        "communication",
        "computer_vision",
        "daily_life_services",
        "data_management",
        "design",
        "developer_tools",
        "document_processing",
        "documentation",
        "education",
        "file_system",
        "financial",
        "geospatial",
        "healthcare",
        "human_interaction",
        "information_retrieval",
        "integration",
        "mcp_protocol",
        "multimedia",
        "multimodal",
        "natural_language_processing",
        "observability",
        "productivity",
        "science",
        "security",
        "telecom",
        "transport",
        "unknown",
        "web",
        "workflow"
      ]
    },
    "primary_subdomain": {
      "description": "null or lower_snake_case; must not duplicate primary_domain; null when unsupported.",
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": [
        "string",
        "null"
      ]
    },
    "resource_object": {
      "description": "Object phrase after removing action words and function words (<= 3 words); null when absent.",
      "type": [
        "string",
        "null"
      ]
    },
    "secondary_domains": {
      "description": "Auxiliary domain clues; unique, no unknown, never equal to primary_domain.",
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "supported_actions": {
      "description": "All directly supported action classes detected in name and first-sentence description; ['unknown'] only when no action evidence exists.",
      "items": {
        "enum": [
          "search",
          "list",
          "retrieve",
          "create",
          "update",
          "delete",
          "execute",
          "transform",
          "communicate",
          "transfer",
          "interact",
          "unknown"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "task_intent": {
      "additionalProperties": false,
      "description": "Structured intent; canonical_text only in single-action mode with a clear object.",
      "properties": {
        "actions": {
          "items": {
            "enum": [
              "search",
              "list",
              "retrieve",
              "create",
              "update",
              "delete",
              "execute",
              "transform",
              "communicate",
              "transfer",
              "interact",
              "unknown"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "canonical_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "object": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualifiers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "actions"
      ],
      "type": "object"
    }
  },
  "required": [
    "primary_domain",
    "primary_subdomain",
    "secondary_domains",
    "supported_actions",
    "primary_action",
    "action_mode",
    "effect_class",
    "resource_object",
    "cardinality",
    "task_intent"
  ],
  "title": "UTSR-ToolMeta functional profile (semantic fields only)",
  "type": "object"
}
